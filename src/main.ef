program main
  use clock_m
  use constants_m
  use field_m
  use timekeeper_m
  use ut_m
  use input_m
  use worldline_m
  use worldlineset_m
  implicit none

  integer :: nstep = 0
  integer :: nstep_max = 10000

                                          !{main  }{{STT}}
  call Input.read                         !{main  }{iput r}
  call Timekeeper.initialize              !{main  }{time i}
  call worldlineset__initialize           !{main  }{wlns s}
!-call iPrint                             !{main  }{iprint}

  do while ( Timekeeper.t < WORLDLINESET__TIME_SPAN_END )
    nstep += 1                            !{{count}}
    call Timekeeper.update                !{main  }{time u}
!-  call Timekeeper.print_time            !{main  }{time p}
    call worldlineset__update             !{main  }{mhd up}
  end do

  call worldlineset__summary
!-call iPrint                             !{main  }{iprint}
                                          !{main  }{{END}}
!-                                        !{{print}}

contains

  subroutine iPrint
    logical :: in_the_beginning = .true.

    if ( in_the_beginning ) then
      call ut__message_leader( "Job starts on", ut__date_and_time() )
      call constants__print
      in_the_beginning = .false.
    else ! in the end of the simulation
      call ut__message_leader( "Job ends on", ut__date_and_time() )
    end if
  end subroutine iPrint

end program main
