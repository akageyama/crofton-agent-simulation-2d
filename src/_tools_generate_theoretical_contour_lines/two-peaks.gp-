reset

L = 0.60
W = 0.20

# peak 1: (-0.5, 0.5)
q1(x,t) = (x+t)**2/(2*L**2) \
        + (t-x-1.0)**2/(2*W**2)

# peak 2: (0.5, 1.5)
q2(x,t) = (x+t-2.0)**2/(2*L**2) \
        + (t-x-1.0)**2/(2*W**2)

f1(x,t) = exp(-q1(x,t))
f2(x,t) = exp(-q2(x,t))

f(x,t) = f1(x,t) + f2(x,t)

set xrange [-1:1]
set yrange [0:2]

set xlabel "x"
set ylabel "t"

set size ratio -1

set samples 400
set isosamples 400

set contour base
unset surface

set cntrparam levels auto 10

set table "contour.dat"
splot f(x,y)
unset table

# f = 0.48 の等高線だけを別に生成
set cntrparam levels discrete 0.50

set table "contour_050.dat"
splot f(x,y)
unset table

# 灰色の等高線の上に f=0.50 を青太線で重ねる
plot "contour.dat" using 1:2 \
     with lines lc rgb "#aaaaaa" lw 1.0 notitle, \
     "contour_050.dat" using 1:2 \
     with lines lc rgb "blue" lw 3.0 notitle

pause -1
