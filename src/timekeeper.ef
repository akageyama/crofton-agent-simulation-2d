module timekeeper_m
  use constants_m
  use ut_m
  implicit none
  private
  public :: Timekeeper

  type, public :: timekeeper_t
    real(DR) :: dt
    real(DR) :: t
  contains
    procedure :: initialize => timekeeper__initialize
    procedure :: update     => timekeeper__update
    procedure :: print_time => timekeeper__print_time
  end type timekeeper_t

  type(timekeeper_t) :: Timekeeper


contains


  subroutine timekeeper__print_time( timekeeper )
    class(timekeeper_t) <in> :: timekeeper

    call ut__message( "t = "  , timekeeper.t )
  end subroutine timekeeper__print_time


  subroutine timekeeper__initialize( timekeeper )
    class(timekeeper_t) <out> :: timekeeper

    timekeeper.dt = 1.e-4_DR
    timekeeper.t  = 0.0_DR
  end subroutine timekeeper__initialize


  subroutine timekeeper__update( timekeeper )
    class(timekeeper_t) <io> :: timekeeper
    timekeeper.t += timekeeper.dt
  end subroutine timekeeper__update



end module timekeeper_m

